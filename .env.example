# Copy to .env to override the defaults below (all optional). Relative paths are resolved
# against the project root; ~ is expanded.

# SLEEPWATCH_DATA_DIR=data                 # moves raw/, interim/ and processed/ together
# SLEEPWATCH_RAW_DIR=data/raw              # the dataset folder that contains SHA256SUMS.txt
# SLEEPWATCH_INTERIM_DIR=data/interim      # manifest and per-night caches (several GB)
# SLEEPWATCH_PROCESSED_DIR=data/processed  # epoch-level feature tables
# SLEEPWATCH_RESULTS_DIR=results           # experiment outputs
